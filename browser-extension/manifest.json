{
  "manifest_version": 3,
  "name": "MediaSeed",
  "version": "1.2.2",
  "description": "Send magnetlinks og torrentfiler til din MediaSeed med dit normale login.",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "worker.js"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "Tilføj i MediaSeed", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
